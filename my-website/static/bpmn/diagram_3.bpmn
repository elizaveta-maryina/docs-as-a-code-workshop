    <bpmn:businessRuleTask id="Task_CheckTransition" name="Проверить допустимость перехода статуса" camunda:asyncBefore="true" camunda:asyncAfter="true" camunda:resultVariable="decision" camunda:decisionRef="dec_transition_allowed" camunda:mapDecisionResult="singleResult">
      <bpmn:extensionElements>
